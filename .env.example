# Copy this file to .env.local (gitignored) and populate with STAGING values.
# Never commit .env.local, secret/service-role keys, Google credentials, or Telegram tokens.

# Staging Supabase project URL (e.g., https://<staging-project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# Staging Supabase publishable browser key ONLY (must start with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_staging_key_here

# Optional explicit environment label: local | staging | production
# Defaults to staging in local development; production is blocked during dev and tests.
VITE_APP_ENV=staging

# Optional Vite base path: / for local dev or custom domain, /ED-Roster/ for GitHub Pages
VITE_BASE_PATH=/
